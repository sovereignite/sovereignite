variant: flatcar
version: 1.0.0

passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - ${SSH_AUTHORIZED_KEY}

storage:
  directories:
    - path: /opt/sovereignite/pki/kubernetes
      mode: 448
    - path: /var/lib/sovereignite/tpm
      mode: 448
    - path: /var/lib/sovereignite/tpm2-pkcs11
      mode: 448
  files:
    - path: /etc/hostname
      mode: 420
      contents:
        inline: ${NODE_NAME}
    - path: /etc/hosts
      mode: 420
      contents:
        source: data:text/plain;charset=utf-8;base64,${HOSTS_B64}
    - path: /etc/systemd/network/10-sovereignite.network
      mode: 420
      contents:
        source: data:text/plain;charset=utf-8;base64,${NETWORKD_B64}
    - path: /etc/modules-load.d/99-kubernetes.conf
      mode: 420
      contents:
        inline: |
          br_netfilter
          overlay
    - path: /etc/sysctl.d/99-kubernetes.conf
      mode: 420
      contents:
        inline: |
          net.bridge.bridge-nf-call-iptables = 1
          net.bridge.bridge-nf-call-ip6tables = 1
          net.ipv4.ip_forward = 1
    - path: /etc/ssh/sshd_config.d/40-sovereignite-lockdown.conf
      mode: 420
      contents:
        inline: |
          PasswordAuthentication no
          PermitRootLogin no
          KbdInteractiveAuthentication no
    - path: /etc/sovereignite/node.env
      mode: 420
      contents:
        source: data:text/plain;charset=utf-8;base64,${NODE_ENV_B64}
    - path: /etc/containerd/config.toml
      mode: 420
      contents:
        source: data:text/plain;charset=utf-8;base64,${CONTAINERD_CONFIG_B64}
    - path: /etc/kubernetes/kubeadm.yaml
      mode: 420
      contents:
        source: data:text/plain;charset=utf-8;base64,${KUBEADM_CONFIG_B64}
    - path: /opt/sovereignite/bin/bootstrap-node.sh
      mode: 493
      contents:
        inline: |
          #!/usr/bin/env bash
          set -euo pipefail

          . /etc/sovereignite/node.env

          install_public_pki() {
            mkdir -p /etc/kubernetes/pki/etcd
            if [ -d /opt/sovereignite/pki/kubernetes ]; then
              cp -a /opt/sovereignite/pki/kubernetes/. /etc/kubernetes/pki/
              find /etc/kubernetes/pki -type f -name '*-ca.key' -delete
              find /etc/kubernetes/pki -type f -name 'ca.key' -delete
            fi
          }

          assert_platform() {
            test -e /dev/tpmrm0 -o -e /dev/tpm0
            secure_boot_var="$(find /sys/firmware/efi/efivars -name 'SecureBoot-*' -print -quit)"
            test -n "${secure_boot_var}"
            secure_boot_state="$(od -An -t u1 "${secure_boot_var}" | awk '{print $5}')"
            test "${secure_boot_state}" = "1"
          }

          install_public_pki
          assert_platform

          case "${1:-check}" in
            check)
              /opt/bin/kubeadm version
              systemctl is-active --quiet containerd
              ;;
            init)
              test "${ROLE}" = "control-plane"
              test "${NODE_NAME}" = "cp-1"
              /opt/bin/kubeadm init --config /etc/kubernetes/kubeadm.yaml
              ;;
            join)
              test -f /etc/kubernetes/join.yaml
              /opt/bin/kubeadm join --config /etc/kubernetes/join.yaml
              ;;
            *)
              echo "usage: $0 check|init|join" >&2
              exit 64
              ;;
          esac

systemd:
  units:
    - name: systemd-networkd.service
      enabled: true
    - name: sshd.service
      enabled: true
    - name: containerd.service
      enabled: true
    - name: install-kubernetes-tools.service
      enabled: true
      contents: |
        [Unit]
        Description=Install pinned Kubernetes node binaries
        After=network-online.target
        Wants=network-online.target
        ConditionPathExists=!/opt/bin/kubeadm

        [Service]
        Type=oneshot
        ExecStart=/usr/bin/bash -euxo pipefail -c 'mkdir -p /opt/bin /etc/systemd/system/kubelet.service.d; for bin in kubeadm kubelet kubectl; do curl -fsSL --retry 5 --retry-delay 3 -o /opt/bin/${bin} https://dl.k8s.io/release/${KUBERNETES_VERSION}/bin/linux/amd64/${bin}; chmod 0755 /opt/bin/${bin}; done'
        RemainAfterExit=yes

        [Install]
        WantedBy=multi-user.target
    - name: kubelet.service
      enabled: true
      contents: |
        [Unit]
        Description=kubelet
        Documentation=https://kubernetes.io/docs/
        After=containerd.service install-kubernetes-tools.service
        Requires=containerd.service

        [Service]
        ExecStart=/opt/bin/kubelet
        Restart=always
        StartLimitInterval=0
        RestartSec=10

        [Install]
        WantedBy=multi-user.target
    - name: sovereignite-verify-platform.service
      enabled: true
      contents: |
        [Unit]
        Description=Verify Secure Boot and TPM before Kubernetes bootstrap
        After=local-fs.target
        Before=kubelet.service

        [Service]
        Type=oneshot
        ExecStart=/opt/sovereignite/bin/bootstrap-node.sh check

        [Install]
        WantedBy=multi-user.target
