[Unit]
Description=Sovereignite trust and adoption service
Requires=sovereignite-keymanager.service sovereignite-libp2p-init.service sovereignite-ipfs.service
After=sovereignite-keymanager.service sovereignite-libp2p-init.service sovereignite-ipfs.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=sovereignite/trust
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=no
ExecStartPre=/usr/bin/test -x /usr/bin/sovereignite-trust
ExecStart=/usr/bin/sovereignite-trust
ExecStartPost=/opt/sovereignite/bin/sovereignite-wait-ready trust /run/sovereignite/trust/ready.json 60
ExecStartPost=/usr/bin/test -s /run/sovereignite/discovery/config.env
TimeoutStartSec=75s
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/run/sovereignite/discovery /run/sovereignite/trust
ReadWritePaths=/var/lib/sovereignite/public /var/lib/sovereignite/trust
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=sovereignite-pre-kubernetes.target
